# DO NOT COMMIT REAL SECRETS TO GIT.
# Copy this file to .env and fill in values via a secret manager / env injection.

HOST_PORT=8011
FRONTEND_PORT=5177
# DeepSeek API key. Required for AI features; leave empty to disable LLM calls.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
PROCESS_WORKSPACE=workspace/processes
# JWT secret. MUST be set to a high-entropy value (>=32 bytes) in every environment.
JWT_SECRET=
JWT_ACCESS_TTL_MIN=10080
JWT_REFRESH_TTL_DAYS=3650
COOKIE_SECURE=0
COOKIE_SAMESITE=Lax
DEV_SEED_ADMIN=1
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=admin

# DB runtime:
# - postgres is the primary backend
# - switch to sqlite legacy mode with FPC_DB_BACKEND=sqlite
FPC_DB_BACKEND=postgres
DATABASE_URL=postgresql://fpc:fpc@postgres:5432/processmap
FPC_DB_POOL_MIN_SIZE=1
FPC_DB_POOL_MAX_SIZE=8
FPC_DB_STARTUP_CHECK=1

# Redis runtime (primary performance layer, required by default)
REDIS_URL=redis://redis:6379/0
REDIS_REQUIRED=1

# AGENT-SVC: отдельный agent-сервис (docker-compose service "agent").
# Трафик LLM монолита через сервис ВЫКЛЮЧЕН по умолчанию (0); включение — 1.
AGENT_SVC_URL=http://agent:8000
# Internal token shared between monolith and agent service. MUST be set to a high-entropy value.
AGENT_SVC_INTERNAL_TOKEN=
# Fernet key for encrypting persisted LLM settings (backend/app/settings.py).
# Required when LLM features are used. Can be a 32-byte base64 url-safe key or any
# high-entropy secret from which the key is derived via PBKDF2.
LLM_SETTINGS_ENCRYPTION_KEY=
LLM_VIA_AGENT_SVC=0
MONOLITH_INTERNAL_URL=http://api:8000

# ENDPOINT-CHECK: регрессионный сканер read-only эндпоинтов (админка + автозапуск
# после деплоя). Прогон идёт против собственного API, только GET, concurrency <= 2.
# Машинный токен деплой-пайплайна (заголовок X-Deploy-Token); пустой = deploy-авторизация выключена.
ENDPOINT_CHECK_DEPLOY_TOKEN=
# Автозапуск после деплоя: дефолт 1 на stage (BUILD_ENV=stage), иначе 0; env переопределяет.
ENDPOINT_CHECK_RUN_ON_DEPLOY=
# Отложенный старт deploy-прогона (сек) и дебаунс серии деплоев (сек).
ENDPOINT_CHECK_DEPLOY_DELAY_S=45
ENDPOINT_CHECK_DEPLOY_DEBOUNCE_S=300
# Таймаут одного запроса (сек) и общий бюджет прогона (сек).
ENDPOINT_CHECK_REQUEST_TIMEOUT_S=20
ENDPOINT_CHECK_BUDGET_S=900

# Postgres service params (docker-compose)
POSTGRES_DB=processmap
POSTGRES_USER=fpc
POSTGRES_PASSWORD=fpc
POSTGRES_PORT=5432

# Legacy sqlite-only knobs (used when FPC_DB_BACKEND=sqlite)
# PROCESS_STORAGE_DIR=workspace/.session_store
# PROCESS_DB_PATH=workspace/.session_store/processmap.sqlite3
JWT_REFRESH_ROTATION_GRACE_SEC=60
