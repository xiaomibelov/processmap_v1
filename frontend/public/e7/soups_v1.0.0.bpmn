<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_4b5b0f758bc2" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ProcessMap" exporterVersion="0.3">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_tobe" name="TO BE Супы (РТК) — формат v0.3" processRef="Process_tobe_soup" />
  </bpmn:collaboration>
  <bpmn:process id="Process_tobe_soup" isExecutable="false">
    <bpmn:documentation>Супы РТК v1 (E7) — сгенерировано ProcessMap (publish E7).</bpmn:documentation>
    <bpmn:textAnnotation id="TA_recipe">
      <bpmn:text>recipe_context (задаётся для SKU, подставляется при создании process_instance): (пусто). Поле recipe_params в задачах — это ссылки на имена параметров recipe_context, без ${}-подстановок (v0.3).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_equip" name="Оборудование и станции">
        <bpmn:flowNodeRef>Act_get1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_open_c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_open_mw1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_close_mw1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_set_mw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_start_mw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_get2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_p2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_open_mw2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_measure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_close_mw2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_start_mw2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_close_mw3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_close_cont</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_wf" name="Workflow / Оркестратор">
        <bpmn:flowNodeRef>Event_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_restart_catch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_m0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_wait_heat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_wait_heat2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_robot" name="Манипуляторы РТК">
        <bpmn:flowNodeRef>Act_move1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_move2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_move2c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_move3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_dispose_def</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_restart_throw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_transfer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_move4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_move5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act_move6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_start" name="Заказ на суп (message: order_created)">
      <bpmn:messageEventDefinition id="messageEventDefinition_Event_start_1" />
      <bpmn:outgoing>F_start_m0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="Event_restart_catch" name="RESTART_SOUP">
      <bpmn:linkEventDefinition id="LinkDef_Event_restart_catch" />
      <bpmn:outgoing>F_restart_m0</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="GW_m0" name="">
      <bpmn:incoming>F_start_m0</bpmn:incoming>
      <bpmn:incoming>F_restart_m0</bpmn:incoming>
      <bpmn:outgoing>F_m0_get1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_wait_heat" name="Нагрев завершён (heating_finished)">
      <bpmn:messageEventDefinition id="messageEventDefinition_Event_wait_heat_1" />
      <bpmn:incoming>F_smw_wait1</bpmn:incoming>
      <bpmn:outgoing>F_wait1_p2</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_wait_heat2" name="Догрев завершён (heating_finished)">
      <bpmn:messageEventDefinition id="messageEventDefinition_Event_wait_heat2_1" />
      <bpmn:incoming>F_smw2_wait2</bpmn:incoming>
      <bpmn:outgoing>F_wait2_omw2</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Act_publish" name="Опубликовать событие ready_for_packaging">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="publish_event" />
          <camunda:property name="params.event_code" value="ready_for_packaging" />
          <camunda:property name="params.payload_ref" value="container_2" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mv6_pub</bpmn:incoming>
      <bpmn:outgoing>F_pub_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_end" name="Контейнер передан в упаковку">
      <bpmn:incoming>F_pub_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Act_get1" name="Получить контейнер-1 из хранения">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="get_from_storage" />
          <camunda:property name="params.item_ref" value="container_1" />
          <camunda:property name="params.target_ref" value="storage_1" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_m0_get1</bpmn:incoming>
      <bpmn:outgoing>F_get1_mv1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_open_c1" name="Вскрыть контейнер-1">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="open_container" />
          <camunda:property name="params.container_ref" value="container_1" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mv1_opc1</bpmn:incoming>
      <bpmn:outgoing>F_opc1_omw1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_open_mw1" name="Открыть СВЧ">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="open_equipment" />
          <camunda:property name="params.equipment_ref" value="heating_equipment_1" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_opc1_omw1</bpmn:incoming>
      <bpmn:outgoing>F_omw1_mv2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_close_mw1" name="Закрыть СВЧ">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="close_equipment" />
          <camunda:property name="params.equipment_ref" value="heating_equipment_1" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mv2_cmw1</bpmn:incoming>
      <bpmn:outgoing>F_cmw1_set</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_set_mw" name="Установить режим нагрева">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="set_equipment" />
          <camunda:property name="params.equipment_ref" value="heating_equipment_1" />
          <camunda:property name="recipe_params" value="heating_power; heat_time_sec" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cmw1_set</bpmn:incoming>
      <bpmn:outgoing>F_set_p1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="GW_p1" name="">
      <bpmn:incoming>F_set_p1</bpmn:incoming>
      <bpmn:outgoing>F_p1_smw</bpmn:outgoing>
      <bpmn:outgoing>F_p1_get2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Act_start_mw" name="Запустить СВЧ">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="start_equipment" />
          <camunda:property name="params.equipment_ref" value="heating_equipment_1" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_p1_smw</bpmn:incoming>
      <bpmn:outgoing>F_smw_wait1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_get2" name="Получить контейнер-2 из устройства выдачи">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="get_from_storage" />
          <camunda:property name="params.item_ref" value="container_2" />
          <camunda:property name="params.target_ref" value="dispensing_equipment_1" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_p1_get2</bpmn:incoming>
      <bpmn:outgoing>F_get2_mv2c</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="GW_p2" name="">
      <bpmn:incoming>F_wait1_p2</bpmn:incoming>
      <bpmn:incoming>F_mv2c_p2</bpmn:incoming>
      <bpmn:outgoing>F_p2_omw2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Act_open_mw2" name="Открыть СВЧ после нагрева">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="open_equipment" />
          <camunda:property name="params.equipment_ref" value="heating_equipment_1" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_p2_omw2</bpmn:incoming>
      <bpmn:incoming>F_wait2_omw2</bpmn:incoming>
      <bpmn:outgoing>F_omw2_meas</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_measure" name="Измерить температуру супа">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="measure_temperature" />
          <camunda:property name="params.container_ref" value="container_1" />
          <camunda:property name="outputs.temperature_ok" value="temperature_ok" />
          <camunda:property name="outputs.measured_temp_c" value="measured_temp_c" />
          <camunda:property name="recipe_params" value="target_temp_c" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_omw2_meas</bpmn:incoming>
      <bpmn:outgoing>F_meas_g1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_g1" name="Температура ≥ 75 °C?">
      <bpmn:incoming>F_meas_g1</bpmn:incoming>
      <bpmn:outgoing>F_g1_chk</bpmn:outgoing>
      <bpmn:outgoing>F_g1_cmw2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Act_close_mw2" name="Закрыть СВЧ (догрев)">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="close_equipment" />
          <camunda:property name="params.equipment_ref" value="heating_equipment_1" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_g1_cmw2</bpmn:incoming>
      <bpmn:outgoing>F_cmw2_smw2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_start_mw2" name="Запустить СВЧ (догрев)">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="start_equipment" />
          <camunda:property name="params.equipment_ref" value="heating_equipment_1" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cmw2_smw2</bpmn:incoming>
      <bpmn:outgoing>F_smw2_wait2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_check" name="Проверить целостность контейнера-1">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="check" />
          <camunda:property name="params.check_code" value="container_integrity" />
          <camunda:property name="params.object_ref" value="container_1" />
          <camunda:property name="params.expected_value" value="intact" />
          <camunda:property name="outputs.check_ok" value="container_intact" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_g1_chk</bpmn:incoming>
      <bpmn:outgoing>F_chk_g2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_g2" name="Контейнер цел?">
      <bpmn:incoming>F_chk_g2</bpmn:incoming>
      <bpmn:outgoing>F_g2_mv3</bpmn:outgoing>
      <bpmn:outgoing>F_g2_disp</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Act_close_mw3" name="Закрыть СВЧ">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="close_equipment" />
          <camunda:property name="params.equipment_ref" value="heating_equipment_1" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mv3_cmw3</bpmn:incoming>
      <bpmn:outgoing>F_cmw3_tr</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_close_cont" name="Закрыть контейнер-2">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="close_container" />
          <camunda:property name="params.target_ref" value="closing_equipment_1" />
          <camunda:property name="params.container_ref" value="container_2" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mv5_cct</bpmn:incoming>
      <bpmn:outgoing>F_cct_mv6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_move1" name="Перенести контейнер-1 в устройство вскрытия">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="move" />
          <camunda:property name="params.object_ref" value="container_1" />
          <camunda:property name="params.target_ref" value="opening_equipment_1" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_get1_mv1</bpmn:incoming>
      <bpmn:outgoing>F_mv1_opc1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_move2" name="Перенести контейнер-1 в СВЧ">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="move" />
          <camunda:property name="params.object_ref" value="container_1" />
          <camunda:property name="params.target_ref" value="heating_equipment_1" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_omw1_mv2</bpmn:incoming>
      <bpmn:outgoing>F_mv2_cmw1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_move2c" name="Перенести контейнер-2 в станцию перетаривания">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="move" />
          <camunda:property name="params.object_ref" value="container_2" />
          <camunda:property name="params.target_ref" value="transfer_station_1" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_get2_mv2c</bpmn:incoming>
      <bpmn:outgoing>F_mv2c_p2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_move3" name="Перенести контейнер-1 в станцию перетаривания">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="move" />
          <camunda:property name="params.object_ref" value="container_1" />
          <camunda:property name="params.target_ref" value="transfer_station_1" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_g2_mv3</bpmn:incoming>
      <bpmn:outgoing>F_mv3_cmw3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_dispose_def" name="Утилизировать контейнер-1 (дефект)">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="move" />
          <camunda:property name="params.object_ref" value="container_1" />
          <camunda:property name="params.target_ref" value="waste_zone_1" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_g2_disp</bpmn:incoming>
      <bpmn:outgoing>F_disp_throw</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="Event_restart_throw" name="RESTART_SOUP">
      <bpmn:linkEventDefinition id="LinkDef_Event_restart_throw" />
      <bpmn:incoming>F_disp_throw</bpmn:incoming>
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="Act_transfer" name="Перетарить суп из контейнера-1 в контейнер-2">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="transfer" />
          <camunda:property name="params.source_container_ref" value="container_1" />
          <camunda:property name="params.target_container_ref" value="container_2" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cmw3_tr</bpmn:incoming>
      <bpmn:outgoing>F_tr_mv4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_move4" name="Переместить контейнер-1 в зону утилизации">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="move" />
          <camunda:property name="params.object_ref" value="container_1" />
          <camunda:property name="params.target_ref" value="waste_zone_1" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tr_mv4</bpmn:incoming>
      <bpmn:outgoing>F_mv4_mv5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_move5" name="Перенести контейнер-2 в станцию закрытия">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="move" />
          <camunda:property name="params.object_ref" value="container_2" />
          <camunda:property name="params.target_ref" value="closing_equipment_1" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mv4_mv5</bpmn:incoming>
      <bpmn:outgoing>F_mv5_cct</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_move6" name="Перенести контейнер-2 в зону упаковки">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="operation_code" value="move" />
          <camunda:property name="params.object_ref" value="container_2" />
          <camunda:property name="params.target_ref" value="packaging_zone_1" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cct_mv6</bpmn:incoming>
      <bpmn:outgoing>F_mv6_pub</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F_start_m0" sourceRef="Event_start" targetRef="GW_m0" />
    <bpmn:sequenceFlow id="F_restart_m0" sourceRef="Event_restart_catch" targetRef="GW_m0" />
    <bpmn:sequenceFlow id="F_m0_get1" sourceRef="GW_m0" targetRef="Act_get1" />
    <bpmn:sequenceFlow id="F_get1_mv1" sourceRef="Act_get1" targetRef="Act_move1" />
    <bpmn:sequenceFlow id="F_mv1_opc1" sourceRef="Act_move1" targetRef="Act_open_c1" />
    <bpmn:sequenceFlow id="F_opc1_omw1" sourceRef="Act_open_c1" targetRef="Act_open_mw1" />
    <bpmn:sequenceFlow id="F_omw1_mv2" sourceRef="Act_open_mw1" targetRef="Act_move2" />
    <bpmn:sequenceFlow id="F_mv2_cmw1" sourceRef="Act_move2" targetRef="Act_close_mw1" />
    <bpmn:sequenceFlow id="F_cmw1_set" sourceRef="Act_close_mw1" targetRef="Act_set_mw" />
    <bpmn:sequenceFlow id="F_set_p1" sourceRef="Act_set_mw" targetRef="GW_p1" />
    <bpmn:sequenceFlow id="F_p1_smw" sourceRef="GW_p1" targetRef="Act_start_mw" />
