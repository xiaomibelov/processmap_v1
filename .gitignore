# Agent artifacts — prevent large auto-generated files from entering git history
.planning/contours/**/evidence/
.planning/contours/**/*.png
.planning/contours/**/RAG_SEARCH_INDEX_*.json
.planning/contours/**/RAG_MANIFEST_*.json
graphify-out/
tools/agent-ui/
workspace/_bak_*/
*.agent.bak
*.bak.[0-9]*

# Vault has its own git repo for Obsidian sync
vault/.git

# Git worktrees
.worktrees/
frontend/public/build-info.json

# E2E diagnostic screenshots
scripts/e2e/diagnose/

# Golden-report is rewritten by test_transformation_golden.py on every run
# (non-deterministic ordering) — keep it out of the working tree diff.
docs/e35/golden_report.json

# Removed legacy artifacts (main-v2 reset)
.codex/
.fpc_extract_*/

# Keep tracked example envs and source coverage helpers (main-v2 reset)
!.env.example
!deploy/.env.server.example
!frontend/src/features/process/coverage/
!frontend/src/features/process/coverage/**
